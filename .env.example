# FilingSignal configuration. Copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is git-ignored; no key is committed to this repository.
#
# NOTE: none of these are needed to *serve* the dashboard. The committed buffer
# + price CSVs render the full forecast and backtest with zero keys set.

# ---------------------------------------------------------------- serving ----
# Backtest start quarter shown by the API / dashboard.
FILINGSIGNAL_BACKTEST_SINCE="2023 Q1"

# Shared access key for the LLM-spending endpoints (POST /digest, /extract).
# Unset means those endpoints return 503 and nobody can spend the provider key.
FILINGSIGNAL_API_KEY=

# Pin the "today" clock instead of using the real calendar (demo / testing).
# FILINGSIGNAL_TODAY=2026-07-01
# Pin the forecast quarter explicitly (overrides quarter_of(today)).
# FILINGSIGNAL_FORECAST_QUARTER="2026 Q3"

# ------------------------------------------------------- live LLM pipeline ----
# Required only for `refresh` / `extract` / `rate` and the reviewer demo.
FILINGSIGNAL_LLM_PROVIDER=claude          # claude | kimi
FILINGSIGNAL_LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# MOONSHOT_API_KEY=

# SEC requires a contact identity on every EDGAR request.
FILINGSIGNAL_SEC_IDENTITY="Your Name you@example.com"

# ------------------------------------------------------------ paths (opt) ----
# FILINGSIGNAL_BUFFER_PATH=data/buffer.sqlite
# FILINGSIGNAL_PRICES_DIR=data/prices
# FILINGSIGNAL_UNIVERSE_DIR=universe
